{
  "name": "oura-acoustics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Audio-reactive headphone tuning site built on AutoEq measurements.",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "images": "node tools/images.mjs build",
    "models": "node tools/build-models.mjs",
    "vendor": "esbuild tools/vendor/three-entry.js --bundle --format=esm --minify --legal-comments=eof --outfile=public/vendor/three/three.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "three": "^0.187.0"
  }
}
